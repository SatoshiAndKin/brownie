{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "custom.regex"
  ],
  "dependencyDashboard": {
    "enabled": false
  },
  "automerge": false,
  "ignoreUnstable": true,
  "prConcurrentLimit": 1,
  "separateMajorMinor": false,
  "branchPrefix": "renovate/upstream-",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^upstream-release\\.txt$/"
      ],
      "matchStrings": [
        "(?:^|\\r?\\n)(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)(?:\\r?\\n|$)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "brownie",
      "packageNameTemplate": "eth-brownie/brownie",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)$"
    }
  ],
  "prBodyNotes": [
    "Merge the named upstream release tag into this PR before merging it.",
    "Build the native wheel. Validate the installed compiled extensions and the ypricemagic pricing stack before advancing its Brownie pin."
  ]
}
